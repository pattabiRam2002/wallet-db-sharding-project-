{
  "name": "wallet(sharding)",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx tsx test-flow.ts",
    "generate:central": "npx prisma generate --schema=./prisma/central/schema.prisma",
    "generate:shard": "npx prisma generate --schema=./prisma/shards/schema.prisma",
    "generate:all": "npm run generate:central && npm run generate:shard",
    "// --- MIGRATIONS (Using dotenv-cli) ---": "",
    "// 1. Central: Uses default .env": "",
    "migrate:central": "npx prisma migrate dev --schema=./prisma/central/schema.prisma --name init_central",
    "// 2. Shard 0: Uses .env.shard0 (The Master)": "",
    "migrate:shard:create": "npx dotenv -e .env.shard0 -- npx prisma migrate dev --schema=./prisma/shards/schema.prisma --name init_shards",
    "// 3. Shard 1: Uses .env.shard1 (The Follower)": "",
    "migrate:shard:apply:1": "npx dotenv -e .env.shard1 -- npx prisma migrate deploy --schema=./prisma/shards/schema.prisma",
    "migrate:all": "npm run migrate:central && npm run migrate:shard:create && npm run migrate:shard:apply:1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "prisma": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "dotenv-cli": "^11.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
