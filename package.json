{
  "name": "wallet(sharding)",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
  "// --- GENERATE (Does not need DB connection) ---": "",
  "generate:central": "npx prisma generate --schema=./prisma/central.prisma",
  "generate:shard": "npx prisma generate --schema=./prisma/shard.prisma",
  "generate:all": "npm run generate:central && npm run generate:shard",

  "// --- PUSH (Needs specific DB connection) ---": "",
  "// 1. Central: Uses the default .env DATABASE_URL": "",
  "push:central": "npx prisma db push --schema=./prisma/central.prisma --force-reset",
  
  "// 2. Shards: We MUST override DATABASE_URL so prisma.config.ts picks the right one": "",
  "push:shard0": "set DATABASE_URL=postgresql://postgres:123@Pattabi@localhost:8000/shard_0_db && npx prisma db push --schema=./prisma/shard.prisma --force-reset",
  "push:shard1": "set DATABASE_URL=postgresql://postgres:123@Pattabi@localhost:8000/shard_1_db && npx prisma db push --schema=./prisma/shard.prisma --force-reset",
  
  "push:all": "npm run push:central && npm run push:shard0 && npm run push:shard1"
},
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "prisma": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
